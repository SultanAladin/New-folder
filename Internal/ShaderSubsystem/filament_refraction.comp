#version 450

/*====================================================================================================================================
                                                 FILAMENT_REFRACTION.COMP
====================================================================================================================================*/
// 🧩 UV-offset refraction composite — screen-space refraction via normal perturbation.
//    Cost: <0.1ms, 3 lines of core logic.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ⚙️ Inputs
layout(set = 0, binding = 0) uniform sampler2D litColorTex;   // HDR lit scene
layout(set = 0, binding = 1) uniform sampler2D gbufferRT1;    // Normal.XY (octahedral)
layout(set = 0, binding = 2) uniform sampler2D gbufferRT2;    // Roughness.R + Specular.G (for refractionStrength)
layout(set = 0, binding = 3) uniform sampler2D gbufferDepth;  // Depth

// ⚙️ Output
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outRefracted;

// ⚙️ Scene UBO
layout(set = 0, binding = 5) uniform SceneUBO
{
    mat4 viewMatrix;
    mat4 projMatrix;
    mat4 invViewMatrix;
    vec4 lightDirection;
    vec4 lightColor;
    vec4 cameraPosition;
    vec4 timeAndResolution;
} scene;


//------------------------------------------------------------------------------------------------------------------------
//                                               OCTAHEDRAL DECODE
//------------------------------------------------------------------------------------------------------------------------

vec3 decodeOctahedral(vec2 p)
{
    vec3 n = vec3(p.xy, 1.0 - abs(p.x) - abs(p.y));
    if (n.z < 0.0)
    {
        n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0,
                                          n.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(n);
}


//------------------------------------------------------------------------------------------------------------------------
//                                                    MAIN
//------------------------------------------------------------------------------------------------------------------------

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims  = imageSize(outRefracted);

    if (pixel.x >= dims.x || pixel.y >= dims.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(dims);

    float depth = textureLod(gbufferDepth, uv, 0).r;

    // ⚙️ If sky or opaque surface with no refraction, pass through
    if (depth >= 1.0)
    {
        vec4 color = textureLod(litColorTex, uv, 0);
        imageStore(outRefracted, pixel, color);
        return;
    }

    // ① Sample normal and material properties
    vec2 rt1     = textureLod(gbufferRT1, uv, 0).rg;
    vec3 normal  = decodeOctahedral(rt1);
    vec2 rt2     = textureLod(gbufferRT2, uv, 0).rg;

    // 📌 refractionStrength is not directly in GBuffer; using specularF0 > 0.05 as indicator
    //    In production, a separate channel or stencil mask would identify refractive surfaces.
    float refractionStrength = (rt2.g > 0.06) ? (rt2.g - 0.04) * 2.0 : 0.0;
    refractionStrength = clamp(refractionStrength, 0.0, 1.0);

    // ② UV offset refraction — the core 3-line technique
    vec2 refractionOffset = normal.xy * refractionStrength * 0.05;
    vec2 refractedUV      = clamp(uv + refractionOffset, vec2(0.0), vec2(1.0));

    // ③ Sample refracted color
    vec4 refractedColor = textureLod(litColorTex, refractedUV, 0);
    vec4 originalColor  = textureLod(litColorTex, uv, 0);

    // ④ Blend based on refraction strength
    vec4 finalColor = mix(originalColor, refractedColor, refractionStrength);

    imageStore(outRefracted, pixel, finalColor);
}
